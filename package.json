{
  "name": "winecircle",
  "private": true,
  "type": "module",
  "scripts": {
    "pb:test": "cd test/pb && ./pocketbase serve --http=127.0.0.1:8091 --dir=./pb_data --hooksDir=../../pb_hooks --migrationsDir=../../pb_migrations",
    "pb:test:reset": "rm -rf test/pb/pb_data",
    "dev": "cd app && npx vite --port 5174 --host 127.0.0.1",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:report": "playwright show-report test/report"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "playwright": "^1.59.1"
  },
  "dependencies": {
    "dotenv": "^17.4.1",
    "web-push": "^3.6.7"
  }
}
